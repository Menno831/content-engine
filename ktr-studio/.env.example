# ════════════════════════════════════════════════════════════════
# KTR Studio — omgevingsvariabelen
# Kopieer dit bestand naar .env.local en vul de echte waarden in.
# PLAK NOOIT echte sleutels in chat of in git. .env.local is gitignored.
# ════════════════════════════════════════════════════════════════

# ── Demo-modus ──────────────────────────────────────────────────
# true  = toon gelabelde demo-data (met zichtbare banner)
# false = toon alleen echte data; niet-verbonden bronnen tonen lege staat
NEXT_PUBLIC_DEMO_MODE=true

# ── Supabase (database + auth) ──────────────────────────────────
# Aanmaken op https://supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (NOOIT met NEXT_PUBLIC_ prefix): Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ── Instagram: scrape-route (RapidAPI, tijdelijk/test) ──────────
# https://rapidapi.com → "Instagram Scraper Stable API"
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram120.p.rapidapi.com

# ── Instagram: officieel (Meta Graph API, productie) ────────────
# https://developers.facebook.com → App → Instagram Graph API
META_APP_ID=
META_APP_SECRET=
META_GRAPH_REDIRECT_URI=http://localhost:3001/api/auth/instagram/callback

# ── YouTube (Google OAuth + Data API v3) ────────────────────────
# https://console.cloud.google.com → APIs & Services
# YOUTUBE_API_KEY = simpele API-key (Data API v3 inschakelen) -> publieke
# kanaal-stats syncen op basis van yt_channel_id (UC… of @handle). Gratis.
YOUTUBE_API_KEY=
# OAuth alleen nodig voor privé-insights van een eigen kanaal (later):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/youtube/callback

# ── ManyChat (leads/DM-events) ──────────────────────────────────
# ManyChat Pro → Settings → API. Webhook-secret zelf kiezen.
MANYCHAT_API_KEY=
MANYCHAT_WEBHOOK_SECRET=

# ── E-mail (rapporten) — Resend ─────────────────────────────────
RESEND_API_KEY=

# ── Cron (nachtelijke auto-sync) ────────────────────────────────
# Zelf een willekeurig geheim kiezen; Vercel Cron stuurt dit mee.
CRON_SECRET=

# ── AI Visuals (Higgsfield Soul) ────────────────────────────────
# Voor genereren van beeld/video met het Soul-character per klant.
HIGGSFIELD_API_KEY=

# ── Claude API (AI-scripts, Prompts, Studio) ────────────────────
# https://console.anthropic.com → API Keys. Zonder key blijft alles mock.
ANTHROPIC_API_KEY=
